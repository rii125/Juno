public static main() {
    var number : int;
    number = 75878230;

    var floatVar : float;
    floatVar = 3.1415;

    var booleanVar : bool;
    booleanVar = true;
    booleanVar = false;

    var stringVar : string;
    stringVar = "I'm developing Juno.";

    var anyVar : any;
    anyVar = 100;
    anyVar = 3.14;
    anyVar = true;
    anyVar = "Juno";
}